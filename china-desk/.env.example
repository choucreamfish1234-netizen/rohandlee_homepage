# 사이트 주소 (canonical·hreflang·sitemap 기준)
NEXT_PUBLIC_SITE_URL=https://china.lawfirmrohandlee.com
# GA4 측정 ID (예: G-XXXXXXX). 비우면 GA 스크립트를 싣지 않는다
NEXT_PUBLIC_GA_ID=
# 상담 접수 알림 웹훅 (Slack Incoming Webhook / Make / Zapier 등). 비우면 알림 생략
CONSULT_WEBHOOK_URL=
# Supabase — 둘 다 비우면 .data/ 로컬 파일 저장(개발용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 로그인
ADMIN_PASSWORD=
# 세션 서명 키, 32자 이상 (openssl rand -hex 32)
ADMIN_SESSION_SECRET=
